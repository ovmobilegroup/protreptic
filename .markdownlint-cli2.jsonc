{
  // ===========================================================================
  // markdown-lint 口径（CI workflow: .github/workflows/markdown-lint.yml）
  //
  // 背景：本仓 markdown-lint 长期红（2026-09-17 起），真实原因不是"文档写错了"，
  // 而是 globs "**/*.md" 把三类**非人工维护**的 Markdown 也纳入了门：
  //   1) 生成/派生产物（data/figures、web/public/templates、web/dist）
  //   2) 镜像副本（docs/figures 是 data/figures 的镜像；
  //      docs/historical_figures_thinking_modes_library.md 是数据层图书馆的镜像）
  //   3) 归档快照（release/**、docs_site/** = 冻结的旧版本文档站）
  // 红线噪声掩盖了真实信号（Phase30-C4 终审修好的质量门失效问题原先就藏在这片红里）。
  //
  // 口径 = A（收敛到人工维护文档）+ B（存量清零）：
  //   - 被 ignore 的路径是派生产物：修了也会被下一次生成覆盖，改它们没有意义；
  //   - 剩下的人工维护文档（docs/**、tools/**、data/individuals/**、CHANGELOG.md …）
  //     必须零违规，门对它们有牙。
  //
  // 纪律：新增 ignore / override 必须同时给出去重理由，
  //       不允许为了"让门变绿"而放过人工维护文档里的真实缺陷。
  //       改口径时同步更新 docs/ci/markdown_lint_policy.md。
  // ===========================================================================
  "ignores": [
    // 依赖目录（CI 的 lint job 不装依赖，此处为本地复跑一致）
    "**/node_modules/**",
    "**/site-packages/**",
    // 前端构建产物（.gitignore 已声明 web/dist/，历史提交仍被跟踪，收集口径按构建产物对待）
    "web/dist/**",
    // Phase30-B5 放进静态站 public 的模板副本（下载用，源在 web/src 的导出器/模板里）
    "web/public/templates/**",
    // 人物档案的数据层产物（源：data/figures/*.json + 生成器）
    "data/figures/**",
    // docs/figures = data/figures 的镜像副本
    "docs/figures/**",
    // 数据层历史人物图书馆（镜像文档，源在 data/ + tools/）
    "docs/historical_figures_thinking_modes_library.md",
    // 冻结的发布快照（v2.0.0 归档，不再维护）
    "release/**",
    // 旧版独立文档站（mkdocs 现场构建，非本仓维护源）
    "docs_site/**",
    "site_docs/**",
    "_site/**"
  ],

  // ---------------------------------------------------------------------------
  // 跨标题连续编号的清单（MD029 定点豁免）
  //
  // 现象：以下文档用 `### P0/P1/P2 级` 或 `### Phase N` 分节，但清单编号是全篇连续的
  // （P0 是 1-3，P1 从 4 开始 ……）。markdownlint 把标题视为清单终止，于是判定
  // "列表应从 1 开始"，报 Expected: 1; Actual: 4。
  // 这里的编号是内容的排序信息（优先级/全局步骤），不是排版冗余：
  // 按 lint 要求重新编号 = 删信息，所以选择定点豁免。
  // 实现方式：在这 8 个文件里用 `<!-- markdownlint-disable MD029 -->` 行内指令
  // （markdownlint-cli2 v0.13 不对 markdownlint 规则应用本文件的 overrides，
  //  行内指令是跨版本稳定的机制）。MD029 对其它文件照常生效。
  //   docs/09-evolution/knowledge_system_audit.md
  //   docs/planning/phase4_{ART,DIP,MIL,SCI,TECH}_plan.md
  //   docs/review/consistency_review.md
  //   docs/review/phase3_review_report.md
  // ---------------------------------------------------------------------------
}
