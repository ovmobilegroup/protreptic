  "H-CH-001": {
    "figure_code": "H-CH-001",
    "figure_name": "程颢",
    "mode_ids": [
      "M-CH-001",
      "M-CH-002",
      "M-CH-003",
      "M-CH-004",
      "M-CH-005",
      "M-CH-006",
      "M-CH-007",
      "M-CH-008",
      "M-CH-009",
      "M-CH-010"
    ],
    "scenarios_zh": {
      "C-CH-001": {
        "code": "C-CH-001",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-001",
        "title_zh": "浑然同体·一体思维法",
        "description_zh": "'仁者浑然与物同体，义礼智信皆仁也。'仁不是诸多德目之首，而是万物一体的存在体验——德目只是这一体感的展开。把伦理的根放在'关联的实在性'上：我与他人、他物不是分离的原子，而是同一身体的部位，故'莫非己也'。这是从存在结构而非规则推导道德。",
        "application_area": [
          "伦理学",
          "哲学",
          "生态学",
          "系统论"
        ]
      },
      "C-CH-002": {
        "code": "C-CH-002",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-002",
        "title_zh": "自家体贴·亲证命名法",
        "description_zh": "'吾学虽有所受，天理二字却是自家体贴出来。'承认师承有自，同时坚持体系的核心命题必须亲证——不是老师给的名字，而是自己从经验中体贴出来并用最准确的名字固定之。学问的最高动作不是引用，而是'体贴+命名'：让前人未名而人人隐约感到的东西获得概念形式。",
        "application_area": [
          "认识论",
          "哲学",
          "科学史",
          "产品"
        ]
      },
      "C-CH-003": {
        "code": "C-CH-003",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-003",
        "title_zh": "物来顺应·定性不动心法",
        "description_zh": "《定性书》：'所谓定者，动亦定，静亦定；无将迎，无内外……廓然而大公，物来而顺应。'针对'定而未能不动'的困境，程颢指出：定不是拒绝扰动，而是心体在任何情境下自定——情绪来了顺应它、处理它，而不被它拖走。不把心与物、动与静对立，是更高阶的情绪自由。",
        "application_area": [
          "实践智慧",
          "哲学",
          "心理学",
          "领导力"
        ]
      },
      "C-CH-004": {
        "code": "C-CH-004",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-004",
        "title_zh": "痿痹证仁·知觉诊断法",
        "description_zh": "'医书言手足痿痹为不仁，此言最善名状。'程颢借医家语反训仁：身体的健康在于知觉通活——每处能感到、能响应；麻木即'不仁'。由此得到一个反向诊断法：系统的病不是先表现为崩溃，而是先表现为'感觉不到'——关系失联、用户流失、员工冷漠，都是'痿痹'。",
        "application_area": [
          "认识论",
          "哲学",
          "医学",
          "管理学"
        ]
      },
      "C-CH-005": {
        "code": "C-CH-005",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-005",
        "title_zh": "勿忘勿助·火候工夫法",
        "description_zh": "程颢常引孟子'必有事焉而勿正，心勿忘，勿助长也'作为工夫总诀：持守一件事，既不能忘（放任滑落），也不能助（用力过猛、拔苗助长）。真正的难度在中间态——一种不加暴力也不失念的持续在场。这是对'意志力狂热'与'顺其自然'两个极端的精确校正。",
        "application_area": [
          "实践智慧",
          "哲学",
          "行为科学",
          "农业隐喻"
        ]
      },
      "C-CH-006": {
        "code": "C-CH-006",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-006",
        "title_zh": "观生意·生生取象法",
        "description_zh": "'万物之生意最可观，此元者善之长也，斯所谓仁也。'程颢从天地生生不息处直接观'仁'：看哪里在生长、哪里有生机，哪里就有价值之所在。这是一种'取象于生'的判断法——判断一个系统、一项事业、一个组织的健康与前途，先看它的'生意'（新芽、新想法、新人的长势），而非存量规模。",
        "application_area": [
          "认识论",
          "哲学",
          "创新研究",
          "教育"
        ]
      },
      "C-CH-007": {
        "code": "C-CH-007",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-007",
        "title_zh": "鸢飞鱼跃·日用见道法",
        "description_zh": "'鸢飞戾天，鱼跃于渊，言其上下察也。'程颢引《中庸》指出：道不在玄远幽深处，而在鸢飞鱼跃最平常的显现场所——'活泼泼地'。真见道者于极平实处见极活泼：吃饭穿衣、日用常行，无一不是道的呈现。这把修养从'特殊时刻的超越体验'解放为'普通时刻的全然在场'。",
        "application_area": [
          "认识论",
          "哲学",
          "积极心理学",
          "组织文化"
        ]
      },
      "C-CH-008": {
        "code": "C-CH-008",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-008",
        "title_zh": "善恶皆天理·偏差非敌法",
        "description_zh": "'天下善恶皆天理，谓之恶者非本恶，但或过或不及便如此。'恶不是与善对抗的独立实体，而是善的'过与不及'——同一根源的偏斜。这提供了一个高维的看待错误与异见的框架：不把偏差妖魔化为'敌人'，而还原为失衡的度；处理它靠调校，不靠歼灭。",
        "application_area": [
          "本体论",
          "哲学",
          "控制论",
          "冲突调解"
        ]
      },
      "C-CH-009": {
        "code": "C-CH-009",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-009",
        "title_zh": "放身万物·去中心观照法",
        "description_zh": "'放这身来，都在万物中一例看，大小大快活。'主动操作：把'我'从中心位置移出，放回万物之中平列观察——山与我、虫与我、他人与我，一例等观。自我中心一解除，视角立即放大，随之而来的是存在性的轻松（'大小大快活'）。这是一体之仁的入门练习：先平视，后同体。",
        "application_area": [
          "认识论",
          "哲学",
          "心理学",
          "天文学文化"
        ]
      },
      "C-CH-010": {
        "code": "C-CH-010",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-010",
        "title_zh": "如坐春风·随材化育法",
        "description_zh": "朱光庭从学一月，归告人曰：'在春风中坐了一月。'程颢教人'各随其材而有作'，终日端坐如泥塑人而'浑是一团和气'，怒于中未尝形于外。教育不是灌输规条，而是以自身气象为环境、以弟子材质为路线——让每个人在自己的方向上长成。春风之喻点出软性影响力：改变人的不是论证，是被浸润。",
        "application_area": [
          "教育",
          "哲学",
          "教育学",
          "领导力"
        ]
      }
    },
    "scenarios_en": {
      "C-CH-001": {
        "code": "C-CH-001",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-001",
        "title_en": "Forming One Body with All Things: Oneness as Ground",
        "description_en": "'The humane person forms one body with all things.' Ren is not the chief virtue among virtues but the lived experience of oneness—the virtues are its unfoldings. Ethics is derived from the reality of relatedness: self and others are parts of one body, hence 'all is myself.'",
        "application_area": [
          "Ethics",
          "Philosophy",
          "Ecology",
          "personal"
        ]
      },
      "C-CH-002": {
        "code": "C-CH-002",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-002",
        "title_en": "Self-Realized Naming: Working Out the Core Insight Yourself",
        "description_en": "'Though I had teachers, the two characters Tianli I worked out through my own realization.' Honor the lineage, yet insist the core insight be personally attained and fixed with the most accurate name—turning what all vaguely feel but none has named into concept.",
        "application_area": [
          "Epistemology",
          "Philosophy",
          "History of Science",
          "personal"
        ]
      },
      "C-CH-003": {
        "code": "C-CH-003",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-003",
        "title_en": "Responding as Things Come: Settledness Beyond Stillness",
        "description_en": "On Calming the Nature: 'The settled is settled in motion and stillness alike—no anticipating, no trailing; vast and impartial, responding as things come.' Settledness is not refusal of disturbance but self-possession in every context—feelings are met and answered, not suppressed or obeyed.",
        "application_area": [
          "Practical Wisdom",
          "Philosophy",
          "Psychology",
          "personal"
        ]
      },
      "C-CH-004": {
        "code": "C-CH-004",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-004",
        "title_en": "Numbness Diagnoses Not-Ren: Sensitivity as Health Metric",
        "description_en": "'Medical texts call limb numbness not-ren—nothing names it better.' Cheng Hao inverts the medical term: health is felt responsiveness everywhere; numbness is the disease. Hence a reverse diagnostic: systems fail first by ceasing to feel—deadened relations, lost users, indifferent staff are all 'numbness.'",
        "application_area": [
          "Epistemology",
          "Philosophy",
          "Medicine",
          "personal"
        ]
      },
      "C-CH-005": {
        "code": "C-CH-005",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-005",
        "title_en": "Neither Forget nor Force: The Doctrine of Proper Effort",
        "description_en": "Cheng Hao's master-key, drawn from Mencius: 'Keep it ever in view, but without forcing—never forget it, never help it grow.' The difficulty is the middle state: sustained presence without violence or lapse. A precise correction to both willpower-fanaticism and laissez-faire.",
        "application_area": [
          "Practical Wisdom",
          "Philosophy",
          "Behavioral Science",
          "personal"
        ]
      },
      "C-CH-006": {
        "code": "C-CH-006",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-006",
        "title_en": "Observing Vital Impulse: Reading Life-Generation as Method",
        "description_en": "'Most observable is the vital impulse of things—this is ren.' Cheng Hao reads ren directly from life-generation: where growth stirs, value resides. A method of judging by vitality—assess any system's health by its new shoots (new ideas, new people) rather than its stockpile.",
        "application_area": [
          "Epistemology",
          "Philosophy",
          "Innovation Studies",
          "personal"
        ]
      },
      "C-CH-007": {
        "code": "C-CH-007",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-007",
        "title_en": "Hawk Soaring, Fish Leaping: The Way in the Ordinary",
        "description_en": "'The hawk soars, the fish leaps—seen above and below.' The Way is not in esoteric heights but in the vivid ordinary: eating, dressing, daily acts all display it. Liberation of cultivation from rare transcendent moments into full presence in common ones.",
        "application_area": [
          "Epistemology",
          "Philosophy",
          "Positive Psychology",
          "personal"
        ]
      },
      "C-CH-008": {
        "code": "C-CH-008",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-008",
        "title_en": "Good and Evil Both of Heaven: Deviation Is Not Enemy",
        "description_en": "'Good and evil are both of Heavenly Principle: what is called evil is not originally evil, but excess or deficiency.' Evil is not a rival substance but a skew of the same root. A high-order frame for error and dissent: deviations are imbalances to be tuned, not enemies to be destroyed.",
        "application_area": [
          "Ontology",
          "Philosophy",
          "Control Theory",
          "personal"
        ]
      },
      "C-CH-009": {
        "code": "C-CH-009",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-009",
        "title_en": "Placing the Self among the Myriad Things: Decentered Contemplation",
        "description_en": "'Place this body of mine among the myriad things and view it as one instance among them—what great joy!' An operative move: decenter the self to stand as one item among all—mountains, insects, others seen as equals. Ego-release instantly widens the frame and yields existential ease: the entry exercise of oneness.",
        "application_area": [
          "Epistemology",
          "Philosophy",
          "Psychology",
          "personal"
        ]
      },
      "C-CH-010": {
        "code": "C-CH-010",
        "figure_id": "H-CH-001",
        "mode_id": "M-CH-010",
        "title_en": "Sitting in Spring Wind: Education by Atmosphere and Aptitude",
        "description_en": "Zhu Guangting, after a month of study, said he had 'sat in spring wind.' Cheng Hao taught 'each according to his capacities,' sat all day still as a clay statue yet 'all mild harmony,' anger never showing. Education is not rule-transmission but atmosphere as environment, aptitude as route—each grows in his own direction. Wind, not argument, changes people.",
        "application_area": [
          "Education",
          "Philosophy",
          "Education",
          "personal"
        ]
      }
    }
  }
}
