 "quote_table": [
  {
   "entry": "M-LUORQ-001",
   "pack_mode": "M-LUORQ-001",
   "quote_index": 1,
   "date": "1951-03-15",
   "source": "",
   "witness": "W1",
   "attribution": "罗瑞卿",
   "key_quote_zh": "我们的政策从来就是镇压与宽大相结合的，现在也还是镇压与宽大相结合的，这乃是我们的基本政策。",
   "pack_raw_substring": true,
   "chars": 45
  },
  {
   "entry": "M-LUORQ-002",
   "pack_mode": "M-LUORQ-002",
   "quote_index": 2,
   "date": "1950-05-20",
   "source": "《罗瑞卿军事文选》2006 第 566 页",
   "witness": "W7/W9",
   "attribution": "罗瑞卿《关于建设公安部队的报告》",
   "key_quote_zh": "公安部队的指挥关系属军委，工作关系属公安部",
   "pack_raw_substring": true,
   "chars": 21
  },
  {
   "entry": "M-LUORQ-003",
   "pack_mode": "M-LUORQ-003",
   "quote_index": 1,
   "date": "1958-06-11",
   "source": "",
   "witness": "W6",
   "attribution": "罗瑞卿",
   "key_quote_zh": "把公安工作置于党中央和各级党委的绝对领导之下，并在工作中实行放手发动群众，大胆依靠群众的路线，这是我们党在长期革命实践中一个独特的创造。",
   "pack_raw_substring": true,
   "chars": 68
  },
  {
   "entry": "M-LUORQ-004",
   "pack_mode": "M-LUORQ-004",
   "quote_index": 4,
   "date": "1964-05-24",
   "source": "",
   "witness": "W20/ch064",
   "attribution": "罗瑞卿",
   "key_quote_zh": "训练要做到红、硬、活，又红又专；红第一，专第二，但一定要红专结合。",
   "pack_raw_substring": true,
   "chars": 33
  },
  {
   "entry": "M-LUORQ-005",
   "pack_mode": "M-LUORQ-005",
   "quote_index": 1,
   "date": "",
   "source": "",
   "witness": "W20/ch054",
   "attribution": "罗瑞卿（传记转述）",
   "key_quote_zh": "警卫工作一要保证不出乱子，二要不脱离群众。",
   "pack_raw_substring": true,
   "chars": 21
  },
  {
   "entry": "M-LUORQ-006",
   "pack_mode": "M-LUORQ-006",
   "quote_index": 1,
   "date": "",
   "source": "",
   "witness": "W10",
   "attribution": "罗瑞卿",
   "key_quote_zh": "我们必须反对侵犯人民利益、脱离群众的国民党作风。不准坐霸王车、吃霸王饭、看霸王戏!",
   "pack_raw_substring": true,
   "chars": 41
  },
  {
   "entry": "M-LUORQ-007",
   "pack_mode": "M-LUORQ-007",
   "quote_index": 1,
   "date": "1978-08-12",
   "source": "",
   "witness": "W3",
   "attribution": "邓小平悼词",
   "key_quote_zh": "罗瑞卿同志是无产阶级久经考验的忠诚的革命战士，中国人民解放军的杰出领导人，伟大导师毛主席的好学生。",
   "pack_raw_substring": true,
   "chars": 49
  },
  {
   "entry": "M-LUORQ-008",
   "pack_mode": "M-LUORQ-008",
   "quote_index": 3,
   "date": "",
   "source": "",
   "witness": "W15",
   "attribution": "罗瑞卿",
   "key_quote_zh": "如果单纯把政治搞好，别的都不好，垮下来，这种政治恐怕不能算好政治，是空头政治，哪里有这种政治！",
   "pack_raw_substring": true,
   "chars": 47
  },
  {
   "entry": "M-LUORQ-009",
   "pack_mode": "M-LUORQ-009",
   "quote_index": 1,
   "date": "1958-06-11",
   "source": "",
   "witness": "W6",
   "attribution": "罗瑞卿",
   "key_quote_zh": "主要表现为只相信自己，不相信群众；只相信上面，不相信下面；迷信某些技术，看不到人的作用。",
   "pack_raw_substring": true,
   "chars": 44
  },
  {
   "entry": "M-LUORQ-010",
   "pack_mode": "M-LUORQ-010",
   "quote_index": 1,
   "date": "1978-03-26",
   "source": "",
   "witness": "W12",
   "attribution": "罗瑞卿（对华楠）",
   "key_quote_zh": "什么是检验真理的标准？马列主义、毛泽东思想是真理，但不能用来检验自己，只有实践才是检验真理的标准。",
   "pack_raw_substring": true,
   "chars": 49
  }
 ],
