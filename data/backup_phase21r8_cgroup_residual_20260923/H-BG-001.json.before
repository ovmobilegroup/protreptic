  "cross_references": [
    {
      "target_figure_code": "H-SMQ-001",
      "relation_type": "inheritance_and_deviation",
      "description_zh": "班固继承司马迁的史学传统，但将通史改为断代史。他批评《史记》'多聚采访，殊无次第'，创立了断代史的写作范式。两人并称'史汉'，共同奠定了中国正史的基础。",
      "description_en": "Ban Gu inherited Sima Qian's historiographical tradition but transformed comprehensive history into dynastic history. He criticized Shiji as 'gathering too much without order' and established the dynastic history paradigm. Together they are known as 'Shi Han', jointly founding Chinese official historiography."
    },
    {
      "target_figure_code": "H-DZS-001",
      "description_zh": "班固在《汉书》中继承并系统化了董仲舒的天人感应思想，将'汉绍尧运'的正统论建立在阴阳五行的宇宙论框架之上。",
      "description_en": "Ban Gu inherited and systematized Dong Zhongshu's heaven-human resonance thought in the Book of Han, grounding the 'Han inherits Yao mandate' orthodoxy theory within a Yin-Yang Five Elements cosmological framework."
    },
    {
      "target_figure_code": "H-HAN-001",
      "description_zh": "班固与沈幅同处东汉时期，但代表了截然不同的学术路径：班固以史学考据和制度建构见长，沈幅则以文学表达和个人情感记录著称。二人共同体现了东汉学术的两条线索——经史考据与文学抒情。",
      "description_en": "Ban Gu and Shen Fu were both active during the Eastern Han but represented radically different academic paths: Ban Gu excelled in historiographical verification and institutional construction, while Shen Fu was renowned for literary expression and personal emotional recording. Together they embodied two threads of Han scholarship — Confucian historiography and literary lyricism."
    }
  ],
