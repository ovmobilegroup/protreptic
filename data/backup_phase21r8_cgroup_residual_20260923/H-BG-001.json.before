  "primary_domain": "史学/文学/政治哲学",
  "representative_works": ["《汉书》"],
  "historical_significance": "班固（32年-92年），东汉著名史学家、文学家。他继承父亲班彪遗志，历时二十余年编纂《汉书》，开创断代史先河。其史学方法论——贯通古今、考据求实——构成了中国古典史学的核心思维模式。《汉书》与司马迁《史记》并称'史汉'，确立了纪传体断代史的写作范式。",
  "gender": "Male",
  "ethnicity": "Chinese",
  "nationality": "Chinese",
  "civilization_sphere": "East Asian/Chinese/Han dynasty",
  "time_period_standardized": "32 CE - 92 CE",
  "thinking_mode_count": 10,
  "mode_evidence": [
    {
      "mode_id": "M-BG-001",
      "evidence_zh": "《汉书》十志贯通历代典章制度，从食货到五行，以系统性框架整理历史制度变迁，体现制度溯源思维",
      "evidence_en": "The 'Ten Treatises' of the Book of Han systematically traced institutional changes across dynasties from economic to cosmological records, embodying institutional genealogy thinking",
      "source": "《汉书·十志》",
      "key_concepts": ["制度溯源", "系统框架", "历史连续性"]
    },
    {
      "mode_id": "M-BG-002",
      "evidence_zh": "'究天人之际，通古今之变'——司马迁的史学宗旨为班固所继承和深化，以贯通古今变化作为历史书写的核心方法",
      "evidence_en": "'Explore the relationship between Heaven and humanity, understand the changes from antiquity to the present' — Sima Qian's historiographical purpose inherited and deepened by Ban Gu, using the贯通 of historical change as core method",
      "source": "《汉书·叙传》",
      "key_concepts": ["贯通古今", "历史变化", "天人关系"]
    },
    {
      "mode_id": "M-BG-003",
      "evidence_zh": "对史料进行系统考辨，区分原始文献与转述记载，确立'信而好古'的考证标准",
      "evidence_en": "Systematically verified historical materials, distinguishing primary sources from secondary accounts, establishing the 'faithful to antiquity' standard of textual scholarship",
      "source": "《汉书》各传考据",
      "key_concepts": ["史料考证", "文献辨伪", "信而好古"]
    },
    {
      "mode_id": "M-BG-004",
      "evidence_zh": "'汉绍尧运'——以儒家正统观解释汉朝合法性，将历史叙事嵌入道德评价体系",
      "evidence_en": "'Han inherits the Yao mandate' — using Confucian orthodoxy to explain Han dynasty legitimacy, embedding historical narrative within moral evaluation framework",
      "source": "《汉书·高帝纪》赞语",
      "key_concepts": ["正统论", "道德评价", "天命观"]
    },
    {
      "mode_id": "M-BG-005",
      "evidence_zh": "'其言汗天下之实'——以客观真实为史学第一原则，不避讳批判当朝皇帝（如汉武帝穷兵黩武），体现史家实录精神",
      "evidence_en": "'His words reflect the reality of the world' — taking objective truth as the primary principle of historiography, not shying away from criticizing contemporary emperors (such as Emperor Wu's military extravagance), embodying the historian's spirit of factual recording",
      "source": "《汉书》武帝本纪及诸传",
      "key_concepts": ["实录精神", "客观批判", "史家独立"]
    },
    {
      "mode_id": "M-BG-006",
      "evidence_zh": "将司马迁开创的通史体例改为断代史，以高帝至王莽为断，确立'一代一史'的断代范式",
      "evidence_en": "Transformed Sima Qian's comprehensive history format into a dynastic history model, spanning from Gaozu to Wang Mang, establishing the 'one dynasty, one history' paradigm",
      "source": "《汉书》体例创新",
      "key_concepts": ["断代史", "范式创新", "纪传体"]
    },
    {
      "mode_id": "M-BG-007",
      "evidence_zh": "'《春秋》推见至隐'——以《春秋》笔法褒贬历史人物，在叙事中嵌入价值判断",
      "evidence_en": "'The Spring and Autumn Annals reveals hidden meanings' — using the Spring and Autumn Annals technique of praise and blame, embedding value judgments within narrative",
      "source": "《汉书》论赞",
      "key_concepts": ["春秋笔法", "叙事褒贬", "价值判断"]
    },
    {
      "mode_id": "M-BG-008",
      "evidence_zh": "'善言礼乐者，观其化'——通过考察礼乐教化来理解社会风俗变迁，以文化视角分析历史进程",
      "evidence_en": "'Those who speak of ritual and music observe its transformation' — understanding social custom changes through examination of ritual-moral education, analyzing historical processes from a cultural perspective",
      "source": "《汉书·礼乐志》",
      "key_concepts": ["文化视角", "礼乐教化", "社会变迁"]
    },
    {
      "mode_id": "M-BG-009",
      "evidence_zh": "'处子不嫁，节犹不恒'——在政治立场上坚持儒家道统，拒绝与王莽新朝合作，最终因窦宪案受牵连死于狱中",
      "evidence_en": "'A maiden who will not wed keeps her virtue uncertain' — maintaining Confucian orthodoxy in political stance, refusing to cooperate with Wang Mang's Xin dynasty, ultimately implicated by the Dou Xian affair and dying in prison",
      "source": "《后汉书·班固传》",
      "key_concepts": ["道统坚守", "政治立场", "士人气节"]
    },
    {
      "mode_id": "M-BG-010",
      "evidence_zh": "'汉为尧后'——通过谱系考证构建汉朝与上古圣王的血脉联系，以历史叙事服务于政治合法性建构",
      "evidence_en": "'Han descends from Yao' — constructing the Han dynasty's bloodline connection to ancient sage kings through genealogical research, using historical narrative to serve political legitimacy construction",
      "source": "《汉书·高帝纪》",
      "key_concepts": ["谱系考证", "政治合法性", "历史叙事"]
    }
