 "frag_register": [
  [
   {
    "entry": "M-AZJ-001",
    "fragment": "中国第五大发明",
    "sources": [
     "quotes#1(W01)",
     "pack.summary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-001",
    "fragment": "二十一世纪是汉字发挥威力",
    "sources": [
     "quotes#3(W09)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-001",
    "fragment": "汉字是中国第五大发明和中华文化之根",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-001",
    "fragment": "认为汉字是中国第五大发明和中华文化之根，几十年如一日地致力于汉字学研究",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-001",
    "fragment": "撰写了21本汉字学专著，不遗余力地向世界推广汉字",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-001",
    "fragment": "第五大发明",
    "sources": [
     "quotes#1(W01)",
     "pack.summary",
     "pack.boundary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-001",
    "fragment": "1979年至1995年，他利用繁忙的政务和商务间隙，共撰写了21本汉字学专著。",
    "sources": [
     "quotes#2(W08)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-001",
    "fragment": "二十一世纪是汉字发挥威力",
    "sources": [
     "quotes#3(W09)",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-002",
    "fragment": "译书启智—理论著述—技术创新—集团化",
    "sources": [
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-002",
    "fragment": "三经一纬",
    "sources": [
     "quotes#4(W02)",
     "pack.summary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-002",
    "fragment": "三经一纬",
    "sources": [
     "quotes#4(W02)",
     "pack.summary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-002",
    "fragment": "1937年，他翻译出版了日文版《间接成本之研究》。",
    "sources": [
     "quotes#1(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-002",
    "fragment": "用三年时间撰写了60万字的《国际贸易实务》专著，著名学者马寅初先生为此书作序",
    "sources": [
     "quotes#2(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-002",
    "fragment": "他和董事们研究设计的“三经一纬”斜纹布，打开了南非、欧美及东南亚市场",
    "sources": [
     "quotes#4(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-002",
    "fragment": "属下公司70余家，产品远销各国，是六七十年代香港蜚声中外的纺织集团",
    "sources": [
     "quotes#5(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-002",
    "fragment": "他通過翻譯日本商業書籍《間接成本之研究》，驚覺中國的工業生產力遠遠落後於世界列強，遂引發他借外國經濟理論振興中國民族工業的念頭。",
    "sources": [
     "quotes#3(W07)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-002",
    "fragment": "三经一纬",
    "sources": [
     "quotes#4(W02)",
     "pack.summary",
     "pack.name",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-003",
    "fragment": "学外语=会经商",
    "sources": [
     "pack.boundary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-003",
    "fragment": "他不仅在校读书时熟练掌握了英语，而且在工作中刻苦自学了日语、法语、德语和西班牙语，为他日后国际贸易生涯打下了良好基础。",
    "sources": [
     "quotes#1(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-003",
    "fragment": "率队前往欧美国家游说。他备尝艰辛，先后奔走于十几个国家，使香港纺织品一举进入了欧美市场",
    "sources": [
     "quotes#2(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-003",
    "fragment": "他曾經試過十七天中睡了十三張床，時差之下，一天過兩個白晝或兩個夜晚也變成等閒。",
    "sources": [
     "quotes#3(W07)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-003",
    "fragment": "他在不同的國家，能以不同的語言發表演說，很容易便打動了當地人的心。",
    "sources": [
     "quotes#4(W07)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-003",
    "fragment": "多语+专业",
    "sources": [
     "pack.modern",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-004",
    "fragment": "殖民地体制内建言者",
    "sources": [
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-004",
    "fragment": "1970年至1974年，任香港立法局非官守议员。1974年至1978年，任香港行政局非官守议员。",
    "sources": [
     "quotes#1(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-004",
    "fragment": "1970年至1975年，任香港工业总会主席。",
    "sources": [
     "quotes#2(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-004",
    "fragment": "1975年至1979年，任香港贸易发展局主席。",
    "sources": [
     "quotes#3(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-004",
    "fragment": "1985年7月，安子介先生出任香港特别行政区基本法起草委员会副主任委员，同年12月被香港各界一致推举为基本法咨询委员会主任委员。",
    "sources": [
     "quotes#4(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-004",
    "fragment": "先后主持了8次咨委会全体会议，30余次执委会会议，向起草委员会递交了57份报告。",
    "sources": [
     "quotes#5(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-004",
    "fragment": "在起草基本法过程中，先后六次受到邓小平同志接见",
    "sources": [
     "quotes#6(W10)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-004",
    "fragment": "邓小平、江泽民等党和国家领导同志曾先后七次亲切接见他",
    "sources": [
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-004",
    "fragment": "体制内建言",
    "sources": [
     "pack.summary",
     "pack.modern",
     "pack.name",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-005",
    "fragment": "确定性供给",
    "sources": [
     "pack.modern",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "中英谈判应以保持香港繁荣稳定为大前提",
    "sources": [
     "quotes#1(W01)",
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "香港保持繁荣稳定16条",
    "sources": [
     "quotes#2(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "16 条",
    "sources": [
     "pack.summary",
     "pack.boundary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "中英谈判应以保持香港繁荣稳定为大前提",
    "sources": [
     "quotes#1(W01)",
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "香港保持繁荣稳定16条",
    "sources": [
     "quotes#2(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "对稳定香港人心起到了积极作用",
    "sources": [
     "quotes#2(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "1982年，安子介先生在应邀访问北京时提出中英谈判应以保持香港繁荣稳定为大前提的重要建议",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "1984年，他在全国政协六届二次会议上提出“香港保持繁荣稳定16条”重要建议，并在香港报刊发表《保持香港繁荣之我见》等一系列文章，对稳定香港人心起到了积极作用。",
    "sources": [
     "quotes#2(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "一九八四年，即中英簽署聯合聲明的當年，他在全國政協會議上提出保持香港繁榮穩定的十六條建議，對穩定香港人心起到積極的作用。",
    "sources": [
     "quotes#3(W07)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "16 条",
    "sources": [
     "pack.summary",
     "pack.boundary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-005",
    "fragment": "确定性供给",
    "sources": [
     "pack.modern",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-006",
    "fragment": "部首切除法",
    "sources": [
     "quotes#3(W09)",
     "pack.summary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-006",
    "fragment": "安子介",
    "sources": [
     "quotes#4(W08)",
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-006",
    "fragment": "部首切除法",
    "sources": [
     "quotes#3(W09)",
     "pack.summary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-006",
    "fragment": "1982年，他用英文撰写的《解开汉字之谜》在香港出版，受到海内外人士和专家广泛关注，新加坡资政李光耀曾风趣地说：“如果此书出版于我开始学习中文之前，我学习中文就会感到比较容易了。”",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-006",
    "fragment": "1995年，他用英文撰写的《汉字易学》成为外国人学习汉字的热门书。",
    "sources": [
     "quotes#2(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-006",
    "fragment": "此后，又先后写成《解开汉字之谜》中文简缩本、《劈文切字集》、《安子介现代千字文》启蒙篇、书写篇和繁简篇等。",
    "sources": [
     "quotes#4(W08)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-006",
    "fragment": "全书采用“部首切除法”解析汉字，分上下两册构建研究框架：上册从发音、部首定义及四角编码入手，分析170个部首的语义关联；下册通过字形演变、部件组合等维度，探讨笔画增减对字义的影响及汉字对称性特征",
    "sources": [
     "quotes#3(W09)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-006",
    "fragment": "拆解—重组",
    "sources": [
     "pack.modern",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-007",
    "fragment": "安子介式汉字笔形电脑编码法",
    "sources": [
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "切除",
    "sources": [
     "quotes#1(W04)",
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "安子介写字机",
    "sources": [
     "quotes#4(W01)",
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "安子介式汉字笔形电脑编码法",
    "sources": [
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "安子介写字机",
    "sources": [
     "quotes#4(W01)",
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "安子介写字机",
    "sources": [
     "quotes#4(W01)",
     "pack.summary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "本发明的编码方法的特征是，每个汉字取一个且只取一个部首赋予相应的数码，将此部首“切除”后余下的部分赋予另一数码，这两部分数码合起来构成了此汉字的本发明的编码",
    "sources": [
     "quotes#1(W04)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "采用把汉字分成部首和其余部分，分别按笔划规定赋予数字，组成编码，由于采用了六位数字，故无重码，此法亦给出了适用于欧美及日本文字的例子。",
    "sources": [
     "quotes#3(W04)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "他还发明了“安子介汉字六位数电脑编码法”，研究设计的“安子介写字机”成功申请了中、美、英、日和新加坡等五国专利，对推广汉字、弘扬中华文化作出了积极贡献。",
    "sources": [
     "quotes#4(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "不仅得到中、美、英、日与新加坡５国专利，还以发明者姓氏命名，这在中国专利史上属首次。",
    "sources": [
     "quotes#5(W05)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-007",
    "fragment": "安子介中文写字机具有显示、存储、编辑、修改、传输、打印10种文字（包括中文和西方语言）的功能，获得中国、英国、美国、日本和新加坡共5国的发明专利",
    "sources": [
     "quotes#6(W03)",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-008",
    "fragment": "我始终为香港人民服务",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-008",
    "fragment": "博学儒商",
    "sources": [
     "pack.summary",
     "pack.boundary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-008",
    "fragment": "博学儒商",
    "sources": [
     "pack.summary",
     "pack.boundary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-008",
    "fragment": "我始终为香港人民服务",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-008",
    "fragment": "博学儒商",
    "sources": [
     "pack.summary",
     "pack.boundary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-008",
    "fragment": "安子介先生一生热心公益，担任过多项社会公职，以自己的模范行为践行了“我始终为香港人民服务”的诺言。",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-008",
    "fragment": "他十分关注内地的扫盲工作，赠送五万余册著作给全国各省市教委及有需要的贫困地区。",
    "sources": [
     "quotes#2(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-008",
    "fragment": "「你是不是中國人？中國人就要愛中國。",
    "sources": [
     "quotes#3(W07)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-008",
    "fragment": "他艰苦创业，服务社会，热心公益，与人为善。他虚怀若谷，勤奋好学，勇于实践，博学多才，著述丰厚。",
    "sources": [
     "quotes#4(W10)",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-009",
    "fragment": "安子介国际贸易研究奖",
    "sources": [
     "quotes#1(W01)",
     "quotes#2(W02)",
     "pack.summary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-009",
    "fragment": "最高学术奖",
    "sources": [
     "pack.boundary",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-009",
    "fragment": "安子介国际贸易研究奖",
    "sources": [
     "quotes#1(W01)",
     "quotes#2(W02)",
     "pack.summary",
     "pack.name",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-009",
    "fragment": "1991年，他在北京设立“安子介国际贸易研究奖”，为促进中国国际贸易理论教学研究发挥了积极作用。",
    "sources": [
     "quotes#1(W01)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-009",
    "fragment": "他还于1991年在北京设立“安子介国际贸易研究奖”，为中国国际贸易理论教学研究作出了贡献。",
    "sources": [
     "quotes#2(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-009",
    "fragment": "1976年后，荣获香港中文大学名誉法学博士，并被聘为北京对外经济贸易大学、清华大学、广州对外贸易学院、江西师范大学等院校名誉教授。",
    "sources": [
     "quotes#4(W02)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-009",
    "fragment": "為推動我國在國際貿易領域的研究1991年安先生出資設立“安子介國際貿易研究獎”（簡稱“安獎”），頒獎典禮由1996年開始舉辦，在國內外國際貿易研究領域中聲譽卓著，具有較大影響力，被視為中國國際經貿領域中的最高學術獎。",
    "sources": [
     "quotes#3(W03)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-009",
    "fragment": "最高学术奖",
    "sources": [
     "pack.boundary",
     "pack_md"
    ]
   }
  ],
  [
   {
    "entry": "M-AZJ-010",
    "fragment": "從心所欲",
    "sources": [
     "quotes#1(W07)",
     "pack_md"
    ]
   },
   {
    "entry": "M-AZJ-010",
    "fragment": "出山",
    "sources": [
