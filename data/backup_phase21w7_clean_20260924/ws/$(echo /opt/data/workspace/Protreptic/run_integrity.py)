$(echo #!/usr/bin/env python3) import json, sys, os, glob; PROJECT = '/opt/data/workspace/Protreptic'; tests_passed = 0; errors = []; warnings = []; data_files = glob.glob(os.path.join(PROJECT, '*.json')) + glob.glob(os.path.join(PROJECT, 'data', '**', '*.json'), recursive=True) + glob.glob(os.path.join(PROJECT, 'tools', '**', '*.json'), recursive=data_files = [f for f in data_files if os.path.isfile(f)]; print('Found', len(data_files), 'JSON files to validate'); for fpath in sorted(data_files): try: with open(fpath, 'r', encoding='utf-8') as f: data = json.load(f); if isinstance(data, dict): code = data.get('code', ''); name_zh = data.get('name_zh', ''); modes = data.get('modes', []); if not code: warnings.append(fpath + ': missing code'); if name_zh is None or (isinstance(name_zh, str) and not name_zh): pass; if modes: for m in modes: if not isinstance(m, int) and not (isinstance(m, str) and m.isdigit()): errors.append(fpath + ': mode ' + str(m) + ' not integer'); tests_passed += 1; elif isinstance(data, list): tests_passed += 1; else: errors.append(fpath + ': unexpected type'); except json.JSONDecodeError as e: errors.append(fpath + ': invalid JSON - ' + str(e)); except Exception as e: errors.append(fpath + ': ' + str(e)); total = tests_passed + len(errors); print('Tests passed:', tests_passed, '/', total); print('Errors:', len(errors)); for e in errors: print('  ERROR:', e); print('Warnings:', len(warnings)); for w in warnings: print('  WARN:', w); exits_clean = len(errors) == 0; print('Data integrity: CLEAN' if exits_clean else 'FAILED (' + str(len(errors)) + ' errors)'); print('Exit code:', 0 if exits_clean else 1); sys.exit(0 if exits_clean else 1) 